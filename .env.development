# Development Environment Configuration

# API Configuration
VITE_API_URL=http://localhost:3001
VITE_API_TIMEOUT=30000

# CDN Configuration (disabled in development)
VITE_CDN_URL=
VITE_STATIC_URL=

# Analytics Configuration (disabled in development)
