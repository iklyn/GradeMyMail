{
  "name": "grademymail",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:analyze": "npm run build && open dist/stats.html",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
